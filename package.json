    "bearing:sync-teaching": "bash scripts/sync-cursor-bearing-teaching.sh",
    "gitnexus:sync-teaching": "bash scripts/sync-cursor-bearing-teaching.sh",
    "bearing:pack": "bash scripts/pack-bearing-teaching.sh",
    "gitnexus:pack": "bash scripts/pack-bearing-teaching.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "bearing.__gate.opt.wiki": "node scripts/bearing-gate-hint.mjs opt-wiki",
    "bearing:wiki": "bash scripts/run-with-project-tmp.sh gitnexus wiki --provider openai --model gpt-4o-mini --base-url https://api.openai.com/v1",
    "bearing:wiki-force": "bash scripts/run-with-project-tmp.sh gitnexus wiki --force --provider openai --model gpt-4o-mini --base-url https://api.openai.com/v1",
